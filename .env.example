# Example environment settings.
#
# To use them: copy this file to a new file called `.env` and change the values.
# `.env` is listed in .gitignore, so your real values are never committed.
# This example file IS committed, so other people know which settings exist.
#
# Only variables starting with EXPO_PUBLIC_ are available in the app, and they
# are built into the app users download. Never put secrets in them.

EXPO_PUBLIC_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
EXPO_PUBLIC_FORECAST_URL=https://api.open-meteo.com/v1/forecast
